rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is in the authorizedUsers allowlist
    function isAuthorized() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email));
    }

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return isAuthorized()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)).data.isAdmin == true;
    }

    // Helper: check if user is a Head for a specific team
    function isHeadOfTeam(teamId) {
      return isAuthorized()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)).data.accessLevel == "Head's Access"
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)).data.teamId == teamId;
    }

    // Helper: get the user's access level (used for write permission checks)
    function getUserAccessLevel() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)).data.accessLevel;
    }

    // Teams: read by any authorized user, write only by admins
    match /teams/{teamId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthorized();
        allow create, update, delete: if isAdmin();
      }
    }

    // Attendance (old L1–L6): read-only for historical records
    match /attendance/{attendanceId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized()
        && (isAdmin()
            || (getUserAccessLevel() == "Head's Access"));
      allow delete: if isAdmin();
    }

    // Curriculum: read by any authorized user, write only by admins
    match /curriculum/{yearDeptId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();

      match /subjects/{subjectId} {
        allow read: if isAuthorized();
        allow create, update, delete: if isAdmin();
      }
    }

    // Attendance Entries (new per-subject): read by authorized, write by admin/head
    match /attendanceEntries/{entryId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized()
        && (isAdmin()
            || (getUserAccessLevel() == "Head's Access"));
      allow delete: if isAuthorized()
        && (isAdmin()
            || (getUserAccessLevel() == "Head's Access"));
    }

    // Authorized Users: read by any authorized user, write only by admins
    // Exception: users can update their OWN name and role (but NOT isAdmin)
    match /authorizedUsers/{email} {
      allow read: if isAuthorized();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthorized()
            && email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role']));
    }
  }
}
